# Copy to `.env` locally. In production, set these in Vercel → Project → Settings → Environment Variables.

# WalletConnect (https://cloud.walletconnect.com/)
PUBLIC_WALLETCONNECT_PROJECT_ID=

# Ethereum JSON-RPC for reads / prerender (use a dedicated provider for production traffic)
PUBLIC_ETH_RPC_URL=https://ethereum.publicnode.com

# Static prerender count for /rats/[id] pages
PUBLIC_STATIC_RAT_COUNT=1000

# Optional: override GLB URLs when large assets are hosted off-repo (Arweave, R2, Vercel Blob, etc.)
# PUBLIC_HOODRATS_MODEL_URL=https://…/hoodrats.glb
# PUBLIC_UR_WORLD_MODEL_URL=https://…/ur-2-version-2.glb
# PUBLIC_PORTAL_MODEL_URL=https://…/portal.glb

# Optional world tuning (UR rift)
# PUBLIC_UR_WORLD_TARGET_SPAN=124
# PUBLIC_UR_WORLD_STREET_DROP=0.58
# PUBLIC_UR_WORLD_SPAWN_LIFT=0.42
# PUBLIC_PORTAL_DESTINATION=/world/next/
