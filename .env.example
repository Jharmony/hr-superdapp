# Copy to `.env` locally. In production, set these in Vercel → Project → Settings → Environment Variables.

# WalletConnect (https://cloud.walletconnect.com/)
PUBLIC_WALLETCONNECT_PROJECT_ID=

# Ethereum JSON-RPC for reads / prerender (use a dedicated provider for production traffic)
PUBLIC_ETH_RPC_URL=https://ethereum.publicnode.com

# Static prerender count for /rats/[id] pages
PUBLIC_STATIC_RAT_COUNT=1000

# GLB permalinks (Arweave). Set the same three keys on Vercel → Project → Settings → Environment Variables (Production + Preview) so `astro build` embeds them. Copy into `.env` for local dev if you are not using public/models/*.glb.
PUBLIC_HOODRATS_MODEL_URL=https://arweave.net/z1RiuEnthekE2XzQupztyIvfd7BTfbM0GLkKljtHUf0
PUBLIC_PORTAL_MODEL_URL=https://arweave.net/dkXtCWe_Y0NUS3_VGItRpQrzbWtkeWTYl1CYUNc0zbw
PUBLIC_UR_WORLD_MODEL_URL=https://arweave.net/-fvYQHLOW6ueq42aDvSF_Iba8GKr5gI-T-WVQqyiYQw

# Marketplace (OpenSea only — `/api/reservoir/*` proxies OpenSea; no Reservoir).
# Project root `.env` or `.env.local` (https://opensea.io/settings/developer). Restart `astro dev` after edits.
OPENSEA_API_KEY=
# Optional; default hood-rats — must match the collection slug in the OpenSea URL.
# OPENSEA_COLLECTION_SLUG=hood-rats


# Optional world tuning (UR rift)
# PUBLIC_UR_WORLD_TARGET_SPAN=124
# Uniform scale on city GLB after span fit (1 = off; default ~1.5 enlarges world vs Hoodrat). Cyber ignores.
# PUBLIC_UR_WORLD_SCALE_BOOST=1.5
# PUBLIC_UR_WORLD_STREET_DROP=0.58
# PUBLIC_UR_WORLD_SPAWN_LIFT=0.42
# Lower city walk mesh vs Hoodrat (m, positive = asphalt drops). Cyber ignores.
# PUBLIC_UR_WORLD_FEET_CLEAR_DROP=0.44
# Hoodrat Y = urFootTargetY() + this (negative = rat lower). Cyber ignores.
# PUBLIC_UR_RIFT_PLAYER_Y_OFFSET=-0.09
# Rift obstacle XZ hull shrink per edge (m); 0 disables. Default ~0.22 balances doors vs wall leaks.
# PUBLIC_UR_OBSTACLE_XZ_INSET_MAX=0.22
# PUBLIC_PORTAL_DESTINATION=/world/next/
