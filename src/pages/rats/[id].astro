---
import Layout from '../../layouts/Layout.astro';
import { RatPrerenderedDetailPage } from '../../components/hoodrats/RatPrerenderedDetailPage';
import {
  createMetadataPublicClient,
  fetchTokenMetadata,
} from '../../lib/metadata';
import { resolveUri } from '../../lib/uri';

// NOTE: With the Vercel adapter enabled, we render this route on-demand to avoid
// prerendering thousands of pages during build (and to keep deploys fast/reliable).
export const prerender = false;

const id = Number(Astro.params.id);
const client = createMetadataPublicClient();
const meta = await fetchTokenMetadata(client, id);
const anim = meta?.animation_url?.trim();
const img = meta?.image ? resolveUri(meta.image) : undefined;
const title = meta?.name ?? `HOODRAT #${id}`;
---

<Layout {title}>
  <RatPrerenderedDetailPage
    client:only="react"
    tokenId={id}
    title={title}
    description={meta?.description}
    anim={anim}
    img={img}
    attributes={meta?.attributes}
  />
</Layout>
